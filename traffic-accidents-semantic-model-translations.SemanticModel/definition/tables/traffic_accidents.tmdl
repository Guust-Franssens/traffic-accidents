/// Fact table where each row represents a traffic accident. The traffic accidents took place in Belgium over several years. As Belgium is multilingual, the dimension tables contain Dutch and French columns. Therefore best to check with the user if they want french or dutch.
table traffic_accidents
	lineageTag: b84a7748-1919-4123-a53a-9dc1fe5e42af

	/// Counts the total number of traffic accidents.
	measure number_of_traffic_accidents = ```
			COUNTROWS(traffic_accidents) 
			```
		formatString: 0
		lineageTag: 768b78a0-2ec0-4a68-ad83-9556a389cfb0

		changedProperty = IsHidden

	measure number_of_deadly_accidents = CALCULATE([number_of_traffic_accidents], accident_type[accident_type_nl] IN  {"Met doden", "dodelijk gewonden"})
		formatString: 0
		lineageTag: 75e76148-a122-4504-b1a8-ca2818abb290

		changedProperty = IsHidden

	/// The year when the accident took place.
	column year
		dataType: int64
		formatString: 0
		lineageTag: 6dc27107-1938-49db-8cb4-f07e3eb41916
		summarizeBy: sum
		sourceColumn: year

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// The month in which the accident took place (1 being January and 12 December)
	column month
		dataType: int64
		formatString: 0
		lineageTag: 4684ee71-8c07-4177-a3f4-7eebde668f49
		summarizeBy: sum
		sourceColumn: month

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// The hour when the accident took place. Can be any value between 0 and 23 as well as null.
	column hour
		dataType: int64
		formatString: 0
		lineageTag: 32cceebf-ee2f-40e9-9233-9b43d77f014b
		summarizeBy: sum
		sourceColumn: hour

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// The NIS code (Dutch: NIS-code, French: code INS) is a numeric code for regional areas of Belgium. This code is used for statistical data treatment in Belgium.
	column nis_code
		dataType: int64
		formatString: 0
		lineageTag: 1107c6d3-e262-48fb-8dda-6142f7959b8d
		summarizeBy: none
		sourceColumn: nis_code

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Together with longitude forms the coordinates of where the accident took place.
	column latitude
		dataType: double
		lineageTag: b7ee9552-e787-4c35-ae25-351dfb7b9a4b
		summarizeBy: sum
		sourceColumn: latitude

